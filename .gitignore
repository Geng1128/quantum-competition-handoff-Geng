# Everything else under these two artifact trees is local/generated data.
# Files already tracked remain tracked; use git add -f for a deliberately
# selected new checkpoint or source snapshot.
external/**
!external/
!external/new_public/
!external/new_public/rustad_r10_src/
!external/new_public/rustad_r10_src/**
